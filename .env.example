# Configuracion de la aplicacion
PROJECT_NAME="API REST Sistema Bibliotecario"
API_V1_STR="/api/v1"
SECRET_KEY="supersecreto_cambiar_en_produccion_token_jwt_seguro"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos PostgreSQL
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biblioteca_db

# O si deseas usar SQLite para pruebas locales:
# DATABASE_URL=sqlite:///./biblioteca.db
